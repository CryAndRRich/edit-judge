# Copy to .env (git-ignored) and fill in what you need. Never commit .env.

# Contact appended to the crawler's User-Agent
CRAWLER_CONTACT=your-email@example.com
# Salt for hashing usernames; if empty, data/raw/.salt is generated and used
CRAWLER_SALT=

# Reddit API: only after Reddit approves API access (Reddit for Researchers)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# PhotoshopGurus: only after a forum admin explicitly permits crawling
PSG_PERMISSION=
PSG_COOKIE=

# Data: photos of real people and community text. Local only, never commit.
data/

# Secrets (API keys, forum session cookies)
.env
.env.*
!.env.example

# Ranking app: chunks and results on an annotator's computer
apps/ranking/chunks/
apps/ranking/results/
apps/ranking/.venv/

# Notebook state and model outputs (outputs belong in data/ or Kaggle, never in git)
.ipynb_checkpoints/
out/

# Python
.venv/
.venv-ml/
__pycache__/
*.pyc

# OS / editor
.DS_Store
.vscode/
.idea/

# Work folder: everything used to build data/ and every stage output (names, provenance, photos). Never commit.
work/

# Tests (unittest on synthetic data): kept on the coordinator's computer only, not in the repository
tests/

# Kaggle API credentials and run logs
kaggle.json
runs.jsonl

# Web app (apps/web/): uploads, run outputs and downloaded weights stay local; dev_split photos are re-downloaded
# with apps/web/fetch_dev_split.py (only its manifest is committed)
apps/web/web_app/uploads/
apps/web/web_app/outputs/
apps/web/web_app/.cache/
apps/web/dev_split/*.jpg
apps/web/dev_split/*.png
